# Exemple de configuration (copie ce fichier en .env — ne le commite jamais).
# Ollama local par défaut. Pour un téléphone, l'API doit être joignable en HTTPS.
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=
NEXUS_MODEL=qwen2.5:3b
# Jeton facultatif exigé par l'API (à saisir dans NEXUS → Réglages → Mon serveur → Clé)
NEXUS_ACCESS_TOKEN=
CORS_ORIGINS=http://localhost:5173,https://dianahilali3-prog.github.io
